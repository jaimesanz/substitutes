# Production settings for docker-compose.prod.yml. On the server, copy to .env next to the compose
# file and fill in every value. NEVER commit the real file.
#
# Generate secrets with:  openssl rand -hex 32

# Django
SECRET_KEY=
# localhost is for the container healthcheck.
ALLOWED_HOSTS=substitutes.jaimesa.nz,localhost
CSRF_TRUSTED_ORIGINS=https://substitutes.jaimesa.nz
# Empty: the site is served from the root of its own hostname.
DJANGO_SCRIPT_NAME=
SECURE_COOKIES=1

# The database and login on the host's shared Postgres.
POSTGRES_DB=reemplazos
POSTGRES_USER=reemplazos
POSTGRES_PASSWORD=

# Optional: superuser created on the very first start (empty database) only.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Optional: pin the app image to one build (sha-<commit>); unset follows latest.
# IMAGE_TAG=sha-abc1234
