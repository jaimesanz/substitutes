# Copy to .env and fill in real values. NEVER commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
# Comma-separated. Use your EC2 public DNS / domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins for CSRF when behind a domain/HTTPS (production).
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Postgres
POSTGRES_DB=reemplazos
POSTGRES_USER=reemplazos
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Auto-created superuser on first boot (optional; leave blank to skip)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password
